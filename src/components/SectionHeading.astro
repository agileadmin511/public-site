---
import { sitePath } from '../lib/url';

interface Props {
  title: string;
  href: string;
  linkLabel: string;
}

const { title, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <h2>{title}</h2>
  <a href={sitePath(href)}>
    {linkLabel} <span aria-hidden="true">→</span>
  </a>
</div>
