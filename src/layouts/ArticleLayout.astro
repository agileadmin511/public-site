---
import type { ContentEntry, SiteCollection } from '../lib/content';
import { entryPath, prettyCollection } from '../lib/content';
import { formatDate, isoDate } from '../lib/date';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface Props {
  entry: ContentEntry;
  collection: SiteCollection;
  previous?: ContentEntry;
  next?: ContentEntry;
  related?: ContentEntry[];
}

const { entry, collection, previous, next, related = [] } = Astro.props;
const returnLabel = collection === 'blog' ? 'blog' : collection;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={entryPath(collection, entry.id)}
  article
  publishedDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
>
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href={`/${collection}/`}>
        ← Back to {returnLabel}
      </a>
      <p class="eyebrow">{prettyCollection(collection)}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        <span>
          Published{' '}
          <time datetime={isoDate(entry.data.pubDate)}>
            {formatDate(entry.data.pubDate)}
          </time>
        </span>
        {entry.data.updatedDate && (
          <span>
            Updated{' '}
            <time datetime={isoDate(entry.data.updatedDate)}>
              {formatDate(entry.data.updatedDate)}
            </time>
          </span>
        )}
      </div>
      <TagList tags={entry.data.tags} />
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-footer">
      {related.length > 0 && (
        <section aria-labelledby="related-heading">
          <h2 id="related-heading">Related notes</h2>
          <ul class="related-list">
            {related.map((item) => (
              <li>
                <a href={entryPath(item.collection, item.id)}>
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(previous || next) && (
        <nav class="article-pagination" aria-label="Article pagination">
          <div>
            {previous && (
              <>
                <span>Previous</span>
                <a href={entryPath(collection, previous.id)}>
                  {previous.data.title}
                </a>
              </>
            )}
          </div>
          <div>
            {next && (
              <>
                <span>Next</span>
                <a href={entryPath(collection, next.id)}>{next.data.title}</a>
              </>
            )}
          </div>
        </nav>
      )}

      <div class="article-actions">
        <a href={`/${collection}/`}>All {returnLabel}</a>
        <a href="/rss.xml">Subscribe via RSS</a>
      </div>
    </footer>
  </article>
</BaseLayout>
